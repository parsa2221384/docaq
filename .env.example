# ---------------------------------------------------------------
# Copy this file to .env and fill in the values:
#     cp .env.example .env
# ---------------------------------------------------------------

# Get a free key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Free Models Router — picks an available free model automatically.
# Any model ID from https://openrouter.ai/models also works.
OPENROUTER_MODEL=openrouter/free

# Where Chroma stores its vector database.
# Inside Docker this is overridden by docker-compose.yml.
VECTOR_DB_PATH=./data/vector_db

# Django. Generate a real key for anything beyond local development:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=change-me-for-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1